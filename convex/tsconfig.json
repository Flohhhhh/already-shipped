{
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "target": "ESNext",
    "lib": ["ES2023", "DOM"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": [
    "./**/*.ts",
    "../src/proposals/**/*.ts",
    "../src/posts/**/*.ts",
    "../src/jobs/**/*.ts",
    "../src/text/**/*.ts"
  ],
  "exclude": ["node_modules"]
}

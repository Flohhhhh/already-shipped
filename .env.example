# Written by `npx convex dev`. The board needs it; feature matches work without it.
NEXT_PUBLIC_CONVEX_URL=

# Optional semantic rerank for typing-time suggestions. Leave unset for the lexical matcher.
# ALREADY_SHIPPED_MATCHER=embeddings
# ALREADY_SHIPPED_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# ALREADY_SHIPPED_EMBEDDINGS_API_KEY=
# ALREADY_SHIPPED_EMBEDDINGS_MODEL=text-embedding-3-small

# Convex deployment env (`npx convex env set`), not Next.js:
# AUTH_GITHUB_CLIENT_ID
# AUTH_GITHUB_CLIENT_SECRET
# AUTH_DISCORD_CLIENT_ID
# AUTH_DISCORD_CLIENT_SECRET
# AUTH_ALLOWED_ORIGINS
# OPENROUTER_API_KEY
# OPENROUTER_MODEL=openai/gpt-6-luna
# Alternative model slug: openai/gpt-5.6-luna
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# SHIPPED_AUTO_CLOSE_THRESHOLD=0.9
# Admin allowlists are Convex only. Do not set them on Vercel or in Next.js env.
# ADMIN_GITHUB_IDS=48927090
# ADMIN_EMAILS=
# ADMIN_DISCORD_IDS=
# GITHUB_TOKEN is optional. It raises the GitHub rate limit and is required for discussions.
# X_BEARER_TOKEN searches public posts. Leave it unset to skip X.
# GITHUB_TOKEN=
# X_BEARER_TOKEN=

# Set to 1 only when a tool must boot without validating env. Do not use this for normal runs.
# SKIP_ENV_VALIDATION=

    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "typescript-eslint": "8.74.0",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.33.4"
